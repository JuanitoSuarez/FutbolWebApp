37692>>>>>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37695>>>>>>>>>>>        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject
37697>>>>>>>>>>>        Case Begin
37697>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37699>>>>>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37699>>>>>>>>>>>                Case Break
37700>>>>>>>>>>>
37700>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37703>>>>>>>>>>>                // If from parent, this is a constrained drill down.
37703>>>>>>>>>>>                Case Break
37704>>>>>>>>>>>
37704>>>>>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37707>>>>>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37707>>>>>>>>>>>                Case Break
37708>>>>>>>>>>>
37708>>>>>>>>>>>            Case Else // must be nfUndefined
37708>>>>>>>>>>>
37708>>>>>>>>>>>        Case End
37708>>>>>>>>>>>
37708>>>>>>>>>>>        Send SetActionButtons
37709>>>>>>>>>>>
37709>>>>>>>>>>>    End_Procedure
