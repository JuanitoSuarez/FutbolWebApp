38402>>>>>>>    Procedure SetActionButtons
38405>>>>>>>        tWebNavigateData NavigateData
38405>>>>>>>        tWebNavigateData NavigateData
38405>>>>>>>        Boolean bHasRecord
38405>>>>>>>        Handle hoDD
38405>>>>>>>
38405>>>>>>>        Get Server to hoDD
38406>>>>>>>        Get GetNavigateData to NavigateData
38407>>>>>>>        Get HasRecord of hoDD to bHasRecord
38408>>>>>>>
38408>>>>>>>        // let's hide all buttons and then Show the ones we want
38408>>>>>>>        WebSet pbRender of oEditBtn to False
38409>>>>>>>        WebSet pbRender of oSaveBtn to False
38410>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38411>>>>>>>        WebSet pbRender of oDeleteBtn to False
38412>>>>>>>
38412>>>>>>>        If (NavigateData.bReadOnly) Begin
38414>>>>>>>            WebSet pbRender of oEditBtn to True
38415>>>>>>>        End
38415>>>>>>>>
38415>>>>>>>        Else Begin
38416>>>>>>>            WebSet pbRender of oSaveBtn to True
38417>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38418>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38419>>>>>>>        End
38419>>>>>>>>
38419>>>>>>>    End_Procedure
