38290>>>    Procedure SetActionButtons
38293>>>        tWebNavigateData NavigateData
38293>>>        tWebNavigateData NavigateData
38293>>>        Boolean bHasRecord
38293>>>        Handle hoDD
38293>>>
38293>>>        Get Server to hoDD
38294>>>        Get GetNavigateData to NavigateData
38295>>>        Get HasRecord of hoDD to bHasRecord
38296>>>
38296>>>        // let's hide all buttons and then Show the ones we want
38296>>>        WebSet pbRender of oEditBtn to False
38297>>>        WebSet pbRender of oSaveBtn to False
38298>>>        WebSet pbRender of oCancelChangesBtn to False
38299>>>        WebSet pbRender of oDeleteBtn to False
38300>>>
38300>>>        If (NavigateData.bReadOnly) Begin
38302>>>            WebSet pbRender of oEditBtn to True
38303>>>        End
38303>>>>
38303>>>        Else Begin
38304>>>            WebSet pbRender of oSaveBtn to True
38305>>>            WebSet pbRender of oCancelChangesBtn to True
38306>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38307>>>        End
38307>>>>
38307>>>    End_Procedure
38308>>>
38308>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38311>>>        // Close after save
38311>>>        Send NavigateClose Self
38312>>>    End_Procedure
38313>>>
38313>>>    // this will close the view after a delete
38313>>>    Procedure OnViewDeleted Handle hoDDO
38316>>>        Send NavigateClose Self
38317>>>    End_Procedure
