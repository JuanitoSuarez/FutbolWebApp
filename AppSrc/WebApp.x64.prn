37296>>>    Procedure OnLoad
37299>>>        String sPrevStateHash sView
37299>>>        
37299>>>        Forward Send OnLoad
37301>>>        
37301>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37301>>>        Get StateHash of ghoWebApp to sPrevStateHash
37302>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37303>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37305>>>            WebSet psPrevStateHash to sPrevStateHash
37306>>>        End
37306>>>>
37306>>>        
37306>>>    End_Procedure
