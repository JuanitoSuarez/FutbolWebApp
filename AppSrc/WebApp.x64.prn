38338>>>>>>>    Procedure SetActionButtons
38341>>>>>>>        tWebNavigateData NavigateData
38341>>>>>>>        tWebNavigateData NavigateData
38341>>>>>>>        Boolean bHasRecord
38341>>>>>>>        Handle hoDD
38341>>>>>>>
38341>>>>>>>        Get Server to hoDD
38342>>>>>>>        Get GetNavigateData to NavigateData
38343>>>>>>>        Get HasRecord of hoDD to bHasRecord
38344>>>>>>>
38344>>>>>>>        // let's hide all buttons and then Show the ones we want
38344>>>>>>>        WebSet pbRender of oEditBtn to False
38345>>>>>>>        WebSet pbRender of oSaveBtn to False
38346>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38347>>>>>>>        WebSet pbRender of oDeleteBtn to False
38348>>>>>>>
38348>>>>>>>        If (NavigateData.bReadOnly) Begin
38350>>>>>>>            WebSet pbRender of oEditBtn to True
38351>>>>>>>        End
38351>>>>>>>>
38351>>>>>>>        Else Begin
38352>>>>>>>            WebSet pbRender of oSaveBtn to True
38353>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38354>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38355>>>>>>>        End
38355>>>>>>>>
38355>>>>>>>    End_Procedure
38356>>>>>>>
38356>>>>>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38359>>>>>>>        // Close after save
38359>>>>>>>        Send NavigateClose Self
38360>>>>>>>    End_Procedure
38361>>>>>>>
38361>>>>>>>    // this will close the view after a delete
38361>>>>>>>    Procedure OnViewDeleted Handle hoDDO
38364>>>>>>>        Send NavigateClose Self
38365>>>>>>>    End_Procedure
38366>>>>>>>
38366>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38369>>>>>>>        Case Begin
38369>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38371>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
38371>>>>>>>                Case Break
38372>>>>>>>
38372>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38375>>>>>>>                // If from parent, this is a constrained drill down.
38375>>>>>>>                Case Break
38376>>>>>>>
38376>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38379>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38379>>>>>>>                Case Break
38380>>>>>>>
38380>>>>>>>            Case Else // must be nfUndefined
38380>>>>>>>
38380>>>>>>>        Case End
38380>>>>>>>
38380>>>>>>>        Send SetActionButtons
38381>>>>>>>
38381>>>>>>>    End_Procedure
38382>>>>>>>// 2. LA LLEGADA (Solo si venimos del Equipo)
38382>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
38385>>>>>>>        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject
38387>>>>>>>        
38387>>>>>>>        // Si el tipo de navegación es desde el Padre (Equipo), mostramos el mensaje
38387>>>>>>>        If (NavigateData.eNavigateType = nfFromParent) Begin
38389>>>>>>>            Send ShowInfoBox "2. Llegando a la ficha del jugador..."
38390>>>>>>>        End
38390>>>>>>>>
38390>>>>>>>    End_Procedure
38391>>>>>>>
38391>>>>>>>    // 3. PREPARANDO LA VUELTA (Solo si vamos a volver al Equipo)
38391>>>>>>>    Procedure OnGetNavigateBackData tWebNavigateData ByRef NavigateData Handle hoBackToView
38394>>>>>>>        Forward Send OnGetNavigateBackData (&NavigateData) hoBackToView
38396>>>>>>>        
38396>>>>>>>        // Usamos la misma condición para que el mensaje de vuelta solo salte si vinimos del padre
38396>>>>>>>        If (NavigateData.eNavigateType = nfFromParent) Begin
38398>>>>>>>            Send ShowInfoBox "3. Objeto invocado, el q genera la navegación de vuelta"
38399>>>>>>>        End
38399>>>>>>>>
38399>>>>>>>    End_Procedure
38400>>>>>>>End_Object 
