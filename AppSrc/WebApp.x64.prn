38393>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38396>>>>>>>        Case Begin
38396>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38398>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
38398>>>>>>>                Case Break
38399>>>>>>>
38399>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38402>>>>>>>                // If from parent, this is a constrained drill down.
38402>>>>>>>                Case Break
38403>>>>>>>
38403>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38406>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38406>>>>>>>                Case Break
38407>>>>>>>
38407>>>>>>>            Case Else // must be nfUndefined
38407>>>>>>>
38407>>>>>>>        Case End
38407>>>>>>>
38407>>>>>>>        Send SetActionButtons
38408>>>>>>>
38408>>>>>>>    End_Procedure
