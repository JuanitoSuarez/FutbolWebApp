38433>>>>>>>        Case Begin
38433>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38435>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
38435>>>>>>>                Case Break
38436>>>>>>>
38436>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38439>>>>>>>                // If from parent, this is a constrained drill down.
38439>>>>>>>                Case Break
38440>>>>>>>
38440>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38443>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38443>>>>>>>                Case Break
38444>>>>>>>
38444>>>>>>>            Case Else // must be nfUndefined
38444>>>>>>>
38444>>>>>>>        Case End
38444>>>>>>>
38444>>>>>>>        Send SetActionButtons
38445>>>>>>>
38445>>>>>>>    End_Procedure
