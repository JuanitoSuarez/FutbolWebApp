38391>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38394>>>        Case Begin
38394>>>            Case (NavigateData.eNavigateType = nfFromMain)
38396>>>                // If from main, this is a propbably a main file Select to Zoom.
38396>>>                Case Break
38397>>>
38397>>>            Case (NavigateData.eNavigateType = nfFromParent)
38400>>>                // If from parent, this is a constrained drill down.
38400>>>                Case Break
38401>>>
38401>>>            Case (NavigateData.eNavigateType = nfFromChild)
38404>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38404>>>                Case Break
38405>>>
38405>>>            Case Else // must be nfUndefined
38405>>>
38405>>>        Case End
38405>>>
38405>>>        Send SetActionButtons
38406>>>
38406>>>    End_Procedure
38407>>>
38407>>>End_Object 
