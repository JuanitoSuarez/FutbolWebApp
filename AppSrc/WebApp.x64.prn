39006>>>    Procedure SetActionButtons
39009>>>        tWebNavigateData NavigateData
39009>>>        tWebNavigateData NavigateData
39009>>>        Boolean bHasRecord
39009>>>        Handle hoDD
39009>>>
39009>>>        Get Server to hoDD
39010>>>        Get GetNavigateData to NavigateData
39011>>>        Get HasRecord of hoDD to bHasRecord
39012>>>
39012>>>        // let's hide all buttons and then Show the ones we want
39012>>>        WebSet pbRender of oEditBtn to False
39013>>>        WebSet pbRender of oSaveBtn to False
39014>>>        WebSet pbRender of oCancelChangesBtn to False
39015>>>        WebSet pbRender of oDeleteBtn to False
39016>>>
39016>>>        If (NavigateData.bReadOnly) Begin
39018>>>            WebSet pbRender of oEditBtn to True
39019>>>        End
39019>>>>
39019>>>        Else Begin
39020>>>            WebSet pbRender of oSaveBtn to True
39021>>>            WebSet pbRender of oCancelChangesBtn to True
39022>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39023>>>        End
39023>>>>
39023>>>    End_Procedure
