38363>>>    Procedure SetActionButtons
38366>>>        tWebNavigateData NavigateData
38366>>>        tWebNavigateData NavigateData
38366>>>        Boolean bHasRecord
38366>>>        Handle hoDD
38366>>>
38366>>>        Get Server to hoDD
38367>>>        Get GetNavigateData to NavigateData
38368>>>        Get HasRecord of hoDD to bHasRecord
38369>>>
38369>>>        // let's hide all buttons and then Show the ones we want
38369>>>        WebSet pbRender of oEditBtn to False
38370>>>        WebSet pbRender of oSaveBtn to False
38371>>>        WebSet pbRender of oCancelChangesBtn to False
38372>>>        WebSet pbRender of oDeleteBtn to False
38373>>>
38373>>>        If (NavigateData.bReadOnly) Begin
38375>>>            WebSet pbRender of oEditBtn to True
38376>>>        End
38376>>>>
38376>>>        Else Begin
38377>>>            WebSet pbRender of oSaveBtn to True
38378>>>            WebSet pbRender of oCancelChangesBtn to True
38379>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38380>>>        End
38380>>>>
38380>>>    End_Procedure
38381>>>
38381>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38384>>>        // Close after save
38384>>>        Send NavigateClose Self
38385>>>    End_Procedure
38386>>>
