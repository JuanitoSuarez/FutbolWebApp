37664>>>>>>>>>>>    Procedure SetActionButtons
37667>>>>>>>>>>>        tWebNavigateData NavigateData
37667>>>>>>>>>>>        tWebNavigateData NavigateData
37667>>>>>>>>>>>        Boolean bHasRecord
37667>>>>>>>>>>>        Handle hoDD
37667>>>>>>>>>>>
37667>>>>>>>>>>>        Get Server to hoDD
37668>>>>>>>>>>>        Get GetNavigateData to NavigateData
37669>>>>>>>>>>>        Get HasRecord of hoDD to bHasRecord
37670>>>>>>>>>>>
37670>>>>>>>>>>>        // let's hide all buttons and then Show the ones we want
37670>>>>>>>>>>>        WebSet pbRender of oEditBtn to False
37671>>>>>>>>>>>        WebSet pbRender of oSaveBtn to False
37672>>>>>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37673>>>>>>>>>>>        WebSet pbRender of oDeleteBtn to False
37674>>>>>>>>>>>
37674>>>>>>>>>>>        If (NavigateData.bReadOnly) Begin
37676>>>>>>>>>>>            WebSet pbRender of oEditBtn to True
37677>>>>>>>>>>>        End
37677>>>>>>>>>>>>
37677>>>>>>>>>>>        Else Begin
37678>>>>>>>>>>>            WebSet pbRender of oSaveBtn to True
37679>>>>>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37680>>>>>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37681>>>>>>>>>>>        End
37681>>>>>>>>>>>>
37681>>>>>>>>>>>    End_Procedure
