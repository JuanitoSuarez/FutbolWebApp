37930>>>    Procedure SetActionButtons
37933>>>        tWebNavigateData NavigateData
37933>>>        tWebNavigateData NavigateData
37933>>>        Boolean bHasRecord
37933>>>        Handle hoDD
37933>>>
37933>>>        Get Server to hoDD
37934>>>        Get GetNavigateData to NavigateData
37935>>>        Get HasRecord of hoDD to bHasRecord
37936>>>
37936>>>        // let's hide all buttons and then Show the ones we want
37936>>>        WebSet pbRender of oEditBtn to False
37937>>>        WebSet pbRender of oSaveBtn to False
37938>>>        WebSet pbRender of oCancelChangesBtn to False
37939>>>        WebSet pbRender of oDeleteBtn to False
37940>>>
37940>>>        If (NavigateData.bReadOnly) Begin
37942>>>            WebSet pbRender of oEditBtn to True
37943>>>        End
37943>>>>
37943>>>        Else Begin
37944>>>            WebSet pbRender of oSaveBtn to True
37945>>>            WebSet pbRender of oCancelChangesBtn to True
37946>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37947>>>        End
37947>>>>
37947>>>    End_Procedure
