38318>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38321>>>        Case Begin
38321>>>            Case (NavigateData.eNavigateType = nfFromMain)
38323>>>                // If from main, this is a propbably a main file Select to Zoom.
38323>>>                Case Break
38324>>>
38324>>>            Case (NavigateData.eNavigateType = nfFromParent)
38327>>>                // If from parent, this is a constrained drill down.
38327>>>                Case Break
38328>>>
38328>>>            Case (NavigateData.eNavigateType = nfFromChild)
38331>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38331>>>                Case Break
38332>>>
38332>>>            Case Else // must be nfUndefined
38332>>>
38332>>>        Case End
38332>>>
38332>>>        Send SetActionButtons
38333>>>
38333>>>    End_Procedure
38334>>>
38334>>>End_Object 
