38322>>>        Case Begin
38322>>>            Case (NavigateData.eNavigateType = nfFromMain)
38324>>>                // If from main, this is a propbably a main file Select to Zoom.
38324>>>                Case Break
38325>>>
38325>>>            Case (NavigateData.eNavigateType = nfFromParent)
38328>>>                // If from parent, this is a constrained drill down.
38328>>>                Case Break
38329>>>
38329>>>            Case (NavigateData.eNavigateType = nfFromChild)
38332>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38332>>>                Case Break
38333>>>
38333>>>            Case Else // must be nfUndefined
38333>>>
38333>>>        Case End
38333>>>
38333>>>        Send SetActionButtons
