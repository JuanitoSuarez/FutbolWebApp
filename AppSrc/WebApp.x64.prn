38480>>>>>>>>>    // Recarga ambas listas posicionando el DD en el jugador indicado
38480>>>>>>>>>    Procedure ActualizarListasJugador RowID riJugador
38483>>>>>>>>>        Boolean bOk
38483>>>>>>>>>
38483>>>>>>>>>        If (not(IsNullRowID(riJugador))) Begin
38485>>>>>>>>>            Get FindByRowIdEx of ojugador_DD jugador.File_Number riJugador to bOk
38486>>>>>>>>>        End
38486>>>>>>>>>>
38486>>>>>>>>>
38486>>>>>>>>>        Send Rebuild_Constraints of ojugadorposicion_DD
38487>>>>>>>>>        Send RefreshListFromDD of oPosicionesDisponiblesList
38488>>>>>>>>>        Send RefreshListFromDD of oPosicionesJugadorList
38489>>>>>>>>>    End_Procedure
38490>>>>>>>>>
38490>>>>>>>>>    // Obtiene el jugador actual y lanza la actualización de listas
38490>>>>>>>>>    Procedure ActualizarListas
38493>>>>>>>>>        RowID riJugador
38493>>>>>>>>>        Get CurrentRowId of ojugador_DD to riJugador
38494>>>>>>>>>        Send ActualizarListasJugador riJugador
38495>>>>>>>>>    End_Procedure
38496>>>>>>>>>
38496>>>>>>>>>    // Recoge la fila seleccionada en la lista izquierda y la asigna
38496>>>>>>>>>    Procedure AsignarPosicionElegida
38499>>>>>>>>>        String sRowId
38499>>>>>>>>>        WebGet psCurrentRowId of oPosicionesDisponiblesList to sRowId
38500>>>>>>>>>        Send AsignarPosicion sRowId
38501>>>>>>>>>    End_Procedure
38502>>>>>>>>>
38502>>>>>>>>>    // Graba el registro jugadorposicion para la posición elegida
38502>>>>>>>>>    Procedure AsignarPosicion String sRowId
38505>>>>>>>>>        Integer iJugadorId iPosicionId
38505>>>>>>>>>        Boolean bFound bOk
38505>>>>>>>>>        RowID riJugador riPosicion
38505>>>>>>>>>
38505>>>>>>>>>        Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorId
38506>>>>>>>>>        Get CurrentRowId of ojugador_DD to riJugador
38507>>>>>>>>>        Move (DeserializeRowID(sRowId)) to riPosicion
38508>>>>>>>>>
38508>>>>>>>>>        If (iJugadorId = 0) Begin
38510>>>>>>>>>            Send UserError "Guarda el jugador antes de asignar posiciones." "Posiciones"
38511>>>>>>>>>            Procedure_Return
38512>>>>>>>>>        End
38512>>>>>>>>>>
38512>>>>>>>>>
38512>>>>>>>>>        If (IsNullRowID(riPosicion)) Begin
38514>>>>>>>>>            Send UserError "Selecciona una posicion antes de asignarla." "Posiciones"
38515>>>>>>>>>            Procedure_Return
38516>>>>>>>>>        End
38516>>>>>>>>>>
38516>>>>>>>>>
38516>>>>>>>>>        // Posicionamos el DD de posicion de escritura en la posicion elegida
38516>>>>>>>>>        Get FindByRowIdEx of oposicionEscritura_DD posicion.File_Number riPosicion to bOk
38517>>>>>>>>>        If (not(bOk)) Begin
38519>>>>>>>>>            Send UserError "No se encontro la posicion seleccionada." "Posiciones"
38520>>>>>>>>>            Procedure_Return
38521>>>>>>>>>        End
38521>>>>>>>>>>
38521>>>>>>>>>        Get Field_Current_Value of oposicionEscritura_DD Field posicion.ID to iPosicionId
38522>>>>>>>>>
38522>>>>>>>>>        // Posicionamos el DD de jugador de escritura en el jugador actual
38522>>>>>>>>>        Get FindByRowIdEx of ojugadorEscritura_DD jugador.File_Number riJugador to bOk
38523>>>>>>>>>        If (not(bOk)) Begin
38525>>>>>>>>>            Send UserError "No se encontro el jugador actual." "Posiciones"
38526>>>>>>>>>            Procedure_Return
38527>>>>>>>>>        End
38527>>>>>>>>>>
38527>>>>>>>>>
38527>>>>>>>>>        // Comprobamos si esa combinacion jugador+posicion ya existe
38527>>>>>>>>>        Send Clear of ojugadorposicionEscritura_DD
38528>>>>>>>>>        Set Field_Changed_Value of ojugadorposicionEscritura_DD Field jugadorposicion.JugadorID to iJugadorId
38529>>>>>>>>>        Set Field_Changed_Value of ojugadorposicionEscritura_DD Field jugadorposicion.PosicionID to iPosicionId
38530>>>>>>>>>        Send Find of ojugadorposicionEscritura_DD GE Index.1
38531>>>>>>>>>        Move (Found and jugadorposicion.JugadorID = iJugadorId and jugadorposicion.PosicionID = iPosicionId) to bFound
38532>>>>>>>>>
38532>>>>>>>>>        If (bFound) Begin
38534>>>>>>>>>            Send UserError "El jugador ya tiene asignada esa posicion." "Posiciones"
38535>>>>>>>>>            Send Clear of ojugadorposicionEscritura_DD
38536>>>>>>>>>            Send ActualizarListasJugador riJugador
38537>>>>>>>>>            Procedure_Return
38538>>>>>>>>>        End
38538>>>>>>>>>>
38538>>>>>>>>>
38538>>>>>>>>>        // Grabamos el nuevo registro
38538>>>>>>>>>        Send Clear of ojugadorposicionEscritura_DD
38539>>>>>>>>>        Set Field_Changed_Value of ojugadorposicionEscritura_DD Field jugadorposicion.JugadorID to iJugadorId
38540>>>>>>>>>        Set Field_Changed_Value of ojugadorposicionEscritura_DD Field jugadorposicion.PosicionID to iPosicionId
38541>>>>>>>>>        Send Request_Save of ojugadorposicionEscritura_DD
38542>>>>>>>>>        Send Clear of ojugadorposicionEscritura_DD
38543>>>>>>>>>        Send ActualizarListasJugador riJugador
38544>>>>>>>>>    End_Procedure
38545>>>>>>>>>
38545>>>>>>>>>    // Recoge la fila seleccionada en la lista derecha y la retira
38545>>>>>>>>>    Procedure RetirarPosicionElegida
38548>>>>>>>>>        String sRowId
38548>>>>>>>>>        WebGet psCurrentRowId of oPosicionesJugadorList to sRowId
38549>>>>>>>>>        Send RetirarPosicion sRowId
38550>>>>>>>>>    End_Procedure
38551>>>>>>>>>
38551>>>>>>>>>    // Borra el registro jugadorposicion correspondiente a la fila elegida
38551>>>>>>>>>    Procedure RetirarPosicion String sRowId
38554>>>>>>>>>        Boolean bOk
38554>>>>>>>>>        RowID riJugador riJugadorPosicion
38554>>>>>>>>>
38554>>>>>>>>>        Get CurrentRowId of ojugador_DD to riJugador
38555>>>>>>>>>        Move (DeserializeRowID(sRowId)) to riJugadorPosicion
38556>>>>>>>>>
38556>>>>>>>>>        If (IsNullRowID(riJugadorPosicion)) Begin
38558>>>>>>>>>            Send UserError "Selecciona una posicion antes de retirarla." "Posiciones"
38559>>>>>>>>>            Procedure_Return
38560>>>>>>>>>        End
38560>>>>>>>>>>
38560>>>>>>>>>
38560>>>>>>>>>        Get FindByRowIdEx of ojugadorposicionEscritura_DD jugadorposicion.File_Number riJugadorPosicion to bOk
38561>>>>>>>>>        If (not(bOk)) Begin
38563>>>>>>>>>            Send UserError "No se pudo seleccionar la posicion para retirarla." "Posiciones"
38564>>>>>>>>>            Procedure_Return
38565>>>>>>>>>        End
38565>>>>>>>>>>
38565>>>>>>>>>
38565>>>>>>>>>        Send Request_Delete of ojugadorposicionEscritura_DD
38566>>>>>>>>>        Send Clear of ojugadorposicionEscritura_DD
38567>>>>>>>>>        Send ActualizarListasJugador riJugador
38568>>>>>>>>>    End_Procedure
38569>>>>>>>>>
38569>>>>>>>>>    // Al llegar a esta vista actualizamos título y cargamos las listas
38569>>>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38572>>>>>>>>>        String sNombre
38572>>>>>>>>>
38572>>>>>>>>>        Move (Trim(jugador.Nombre + " " + jugador.Apellido)) to sNombre
38573>>>>>>>>>        If (sNombre <> "") Begin
38575>>>>>>>>>            WebSet psCaption to ("Posiciones de: " + sNombre)
38576>>>>>>>>>        End
38576>>>>>>>>>>
38576>>>>>>>>>        Else Begin
38577>>>>>>>>>            WebSet psCaption to "Posiciones del jugador"
38578>>>>>>>>>        End
38578>>>>>>>>>>
38578>>>>>>>>>
38578>>>>>>>>>        Send ActualizarListas
38579>>>>>>>>>    End_Procedure
38580>>>>>>>>>
38580>>>>>>>>>End_Object
