38365>>>>>>>    Procedure SetActionButtons
38368>>>>>>>        tWebNavigateData NavigateData
38368>>>>>>>        tWebNavigateData NavigateData
38368>>>>>>>        Boolean bHasRecord
38368>>>>>>>        Handle hoDD
38368>>>>>>>
38368>>>>>>>        Get Server to hoDD
38369>>>>>>>        Get GetNavigateData to NavigateData
38370>>>>>>>        Get HasRecord of hoDD to bHasRecord
38371>>>>>>>
38371>>>>>>>        // let's hide all buttons and then Show the ones we want
38371>>>>>>>        WebSet pbRender of oEditBtn to False
38372>>>>>>>        WebSet pbRender of oSaveBtn to False
38373>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38374>>>>>>>        WebSet pbRender of oDeleteBtn to False
38375>>>>>>>
38375>>>>>>>        If (NavigateData.bReadOnly) Begin
38377>>>>>>>            WebSet pbRender of oEditBtn to True
38378>>>>>>>        End
38378>>>>>>>>
38378>>>>>>>        Else Begin
38379>>>>>>>            WebSet pbRender of oSaveBtn to True
38380>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38381>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38382>>>>>>>        End
38382>>>>>>>>
38382>>>>>>>    End_Procedure
38383>>>>>>>
38383>>>>>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38386>>>>>>>        // Close after save
38386>>>>>>>        Send NavigateClose Self
38387>>>>>>>    End_Procedure
38388>>>>>>>
38388>>>>>>>    // this will close the view after a delete
38388>>>>>>>    Procedure OnViewDeleted Handle hoDDO
38391>>>>>>>        Send NavigateClose Self
38392>>>>>>>    End_Procedure
