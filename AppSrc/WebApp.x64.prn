37652>>>>>>>>>>>        Else Begin
37653>>>>>>>>>>>            WebSet pbRender of oSaveBtn to True
37654>>>>>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37655>>>>>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37656>>>>>>>>>>>        End
