39040>>>            Case (NavigateData.eNavigateType = nfFromParent)
39043>>>                // If from parent, this is a constrained drill down.
39043>>>                Case Break
39044>>>
39044>>>            Case (NavigateData.eNavigateType = nfFromChild)
39047>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39047>>>                Case Break
39048>>>
39048>>>            Case Else // must be nfUndefined
39048>>>
39048>>>        Case End
39048>>>
39048>>>        Send SetActionButtons
