37601>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37604>>>        Case Begin
37604>>>            Case (NavigateData.eNavigateType = nfFromMain)
37606>>>                // If from main, this is a propbably a main file Select to Zoom.
37606>>>                Case Break
37607>>>
37607>>>            Case (NavigateData.eNavigateType = nfFromParent)
37610>>>                // If from parent, this is a constrained drill down.
